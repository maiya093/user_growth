   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "客户类型",
   "options": "快递网点\n外卖站点\n同城配送\n企业车队\n个人骑手",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "column_break_customer",
   "fieldtype": "Column Break"
  },
  {
   "default": "华东",
