   "options": "网点直签\n渠道代理\n地推活动\n老客推荐\n平台合作",
   "search_index": 1
  },
  {
   "fieldname": "owner_sales",
   "fieldtype": "Link",
   "label": "招商 / 运营负责人",
   "options": "User"
  },
  {
   "fieldname": "open_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "开通日期",
   "search_index": 1
  },
  {
   "depends_on": "eval:doc.record_type=='服务中止'",
   "fieldname": "churn_section",
   "fieldtype": "Section Break",
   "label": "中止信息"
  },
  {
   "fieldname": "churn_date",
   "fieldtype": "Date",
   "label": "中止日期",
   "search_index": 1
  },
  {
   "depends_on": "eval:doc.record_type=='服务中止'",
   "fieldname": "churn_type",
   "fieldtype": "Select",
   "label": "中止类型",
   "options": "\n主动退租\n欠费停机\n到期未续\n站点合并\n客户停业"
  },
  {
   "depends_on": "eval:doc.record_type=='服务中止'",
   "fieldname": "churn_reason",
   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "中止原因",
   "options": "\n单价过高\n续航不足\n站点太远\n电池老旧\n押金与结算纠纷\n车辆淘汰\n竞品更低\n客户停业\n其他",
   "search_index": 1
  },
  {
   "fieldname": "column_break_churn",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.record_type=='服务中止'",
