   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "USR-OPEN-.YYYY.-\nUSR-CHRN-.YYYY.-",
   "reqd": 1
  },
  {
   "default": "服务开通",
   "fieldname": "record_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "单据类型",
   "options": "服务开通\n服务中止",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "customer_section",
   "fieldtype": "Section Break",
   "label": "客户信息"
  },
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "in_global_search": 1,
   "in_list_view": 1,
   "label": "客户名称",
   "reqd": 1
  },
  {
   "description": "客户唯一标识，同一客户多次开通/中止沿用同一编号，同时可作为外部业务系统 ID 的映射位。",
