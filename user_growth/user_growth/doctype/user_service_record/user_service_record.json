   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "大区",
   "options": "华东\n华南\n华中\n西南\n华北\n东北\n西北\n海外",
   "reqd": 1,
   "search_index": 1
  },
  {
   "default": "杭州",
   "fieldname": "city",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "城市",
   "options": "杭州\n上海\n南京\n苏州\n宁波\n广州\n深圳\n东莞\n佛山\n曼谷\n吉隆坡",
   "reqd": 1,
   "search_index": 1
  },
